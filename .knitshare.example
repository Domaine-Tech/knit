# .knitshare — Configuration partagée du coffre-fort Knit
# Répliqué entre les dossiers locaux qui portent le même id.
# Le dossier .knit/ et la clé de personne ne quittent pas la machine.
# Lisible et modifiable par les humains comme par les agents IA.

nom: "Knit Workspace"
id: "00000000-0000-4000-8000-000000000001"
version: 2

structure:
  wiki: "wiki/"
  taches: "projet/taches/"
  sprints: "projet/sprints/"
  assets: "assets/"

conventions:
  statuts: [backlog, a-faire, en-cours, en-revue, termine]
  priorites: [basse, moyenne, haute, critique]
  format_id: "task-{NNN}"

mermaid:
  theme_sync: true           # Les diagrammes s'adaptent dynamiquement au thème de l'utilisateur
