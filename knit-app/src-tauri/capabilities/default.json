{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Knit main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:app:allow-version",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:default",
    "allow-get-vault-tree",
    "allow-read-vault-file",
    "allow-write-vault-file",
    "allow-create-vault-file",
    "allow-create-vault-dir",
    "allow-delete-vault-path",
    "allow-trash-vault-path",
    "allow-restore-vault-path",
    "allow-commit-vault-trash",
    "allow-pick-vault-folder",
    "allow-reveal-in-explorer",
    "allow-start-vault-watcher",
    "allow-stop-vault-watcher",
    "allow-save-vault-asset",
    "allow-rename-vault-file",
    "allow-parse-frontmatter",
    "allow-update-frontmatter",
    "allow-get-file-backlinks",
    "allow-recover-vault-trash",
    "allow-start-p2p-network",
    "allow-stop-p2p-network",
    "allow-get-p2p-invitation-code",
    "allow-connect-p2p-peer",
    "allow-get-connected-peers",
    "allow-broadcast-yjs-update",
    "allow-broadcast-awareness",
    "allow-sync-asset-from-peers",
    "allow-get-local-peer-identity",
    "allow-get-user-profile",
    "allow-save-user-profile",
    "allow-upload-user-avatar",
    "allow-reset-user-avatar",
    "allow-apply-profile-to-git",
    "allow-save-doc-snapshot",
    "allow-list-doc-snapshots",
    "allow-load-latest-doc-snapshot",
    "allow-send-p2p-sync-step1",
    "allow-send-p2p-sync-step2",
    "allow-load-avatar-base64"
  ]
}
